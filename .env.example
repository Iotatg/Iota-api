# ─────────────────────────────────────────────────────────────
# iota-api configuration (placeholders — never commit real values)
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=iota-api
APP_ENV=development
APP_DEBUG=false
APP_BASE_URL=http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# PostgreSQL (REQUIRED)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iota_api
POSTGRES_USER=iota
POSTGRES_PASSWORD=change_me_in_production

# Redis (REQUIRED)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Admin token (REQUIRED for /admin/* endpoints)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=change_me_to_a_secure_random_token_at_least_32_chars

# API key settings
API_KEY_PREFIX=iota_
API_KEY_BYTES=32
# 0 = unlimited (the default: keys carry no quota unless you set one)
DEFAULT_DAILY_LIMIT=0
DEFAULT_RATE_PER_MINUTE=0
DEFAULT_CONCURRENT_STREAMS=0

# Storage backend: local | s3
STORAGE_BACKEND=local
# Default points to the same dir as DEMO_AUDIO_DIR so seeded demo files
# are servable out of the box. Override both if you change either.
STORAGE_LOCAL_PATH=./storage/audio

# S3 (only if STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CDN_BASE_URL=

# Caching
METADATA_CACHE_TTL=300
METADATA_CACHE_MAX_SIZE=10000
RATE_LIMIT_WINDOW_SECONDS=60

# Streaming
STREAM_CHUNK_SIZE=65536
STREAM_DEFAULT_QUALITY=128

# Demo provider
DEMO_AUDIO_DIR=./storage/audio

# Security
CORS_ALLOW_ORIGINS=*
MAX_REQUEST_SIZE=1048576
# Host header values the app answers to. "*" accepts any Host (needed
# behind a load balancer); set the real domains in production to stop
# Host-header injection.
ALLOWED_HOSTS=*
# Serve /swagger, /redoc, /openapi.json. Turn off for a public deploy.
ENABLE_DOCS=true
# Send Strict-Transport-Security. Only enable behind TLS.
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
# Per-IP request budget (per minute). 0 disables. The app-level guard
# complements the nginx edge limits.
IP_RATE_LIMIT_PER_MINUTE=600
IP_RATE_LIMIT_KEYED_PER_MINUTE=6000
ADMIN_RATE_LIMIT_PER_MINUTE=20
# Trust X-Real-IP / X-Forwarded-For for the client address. Enable only
# behind a trusted proxy that overwrites these headers.
TRUST_PROXY_HEADERS=true

# ─────────────────────────────────────────────────────────────
# Production scaling
# ─────────────────────────────────────────────────────────────
# Uvicorn worker processes (one event loop each). Match the CPU
# allocation of the container. WEB_CONCURRENCY in the Dockerfile
# controls the same thing for the image.
SERVER_WORKERS=4
# Maximum concurrent yt-dlp extractions per worker. Each one is a
# CPU-heavy subprocess; requests queue instead of spawning more.
YTDLP_MAX_CONCURRENCY=4
# Asyncpg pool. Total connections across all workers must stay below
# the database's max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────
# Multi-provider (YouTube / Spotify / JioSaavn / SoundCloud)
# All optional. Providers self-disable when their required
# credential is missing. The DEMO provider is always available.
# ─────────────────────────────────────────────────────────────
# YouTube — at least one of API key or cookies is recommended.
# Without these the YouTube provider is disabled and only the
# demo catalog is served.
YOUTUBE_API_KEY=
# Path to a Netscape-format cookies.txt. Required on datacenter
# IPs (Railway, Render, etc.) to bypass YouTube bot detection.
# Mutually exclusive with YOUTUBE_COOKIES_CONTENT.
YOUTUBE_COOKIES_FILE=
# Alternative: paste the full cookies.txt content as a single env
# var. The provider writes it to a temp file in the container at
# startup. Useful on hosts where file upload is awkward (Railway,
# Render, Fly). Takes precedence over YOUTUBE_COOKIES_FILE.
YOUTUBE_COOKIES_CONTENT=
# Optional HTTP/HTTPS/SOCKS proxy passed to yt-dlp.
YOUTUBE_PROXY=
# Override the yt-dlp executable (default: `python3 -m yt_dlp`).
YOUTUBE_YTDLP_PATH=

# Spotify — optional. Without these, the provider uses the
# public oEmbed endpoint (track title only).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# JioSaavn — public endpoint, no key required.
JIOSAAVN_API_KEY=

# SoundCloud — public oEmbed endpoint, no key required.
SOUNDCLOUD_API_KEY=

# Stream proxy timeouts (seconds) for remote direct_url sources.
STREAM_PROXY_CONNECT_TIMEOUT=10
STREAM_PROXY_READ_TIMEOUT=60

# YouTube IP-level-failure circuit breaker. After N consecutive
# bot-check/429 failures, the primary YouTube client fast-fails for the
# cooldown window (native player-client rotation still tries).
# 0 disables the breaker.
YOUTUBE_BREAKER_THRESHOLD=3
YOUTUBE_BREAKER_COOLDOWN_SECONDS=1800
